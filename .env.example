# Copie para .env e preencha as variáveis de ambiente do StreamRoom.

# Assina os tokens. Obrigatório, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional para integração com Discord Activity.
# No portal: https://discord.com/developers/applications, aba OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

