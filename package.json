{
  "name": "streamroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "viewer"
  ],
  "scripts": {
    "dev": "npm -w viewer run dev",
    "build": "npm -w viewer run build && node -e \"import('fs').then(fs => fs.cpSync('viewer/dist', 'dist', { recursive: true }))\"",
    "preview": "npm -w viewer run preview",
    "update-discord": "node scripts/update-discord-app.mjs",
    "stream": ".venv/bin/python streamer/stream.py || python3 streamer/stream.py",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
