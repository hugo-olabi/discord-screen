{
  "name": "streamroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm -w client run dev",
    "build": "npm -w client run build && node -e \"import('fs').then(fs => fs.cpSync('client/dist', 'dist', { recursive: true }))\"",
    "preview": "npm -w client run preview",
    "update-discord": "node scripts/update-discord-app.mjs",
    "stream": ".venv/bin/python native-streamer/stream.py || python3 native-streamer/stream.py",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}
